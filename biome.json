{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": { "includes": ["packages/**", "services/**", "scripts/**", "tests/**", "*.json"] },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "linter": { "enabled": true, "rules": { "recommended": true, "style": { "useImportType": "error", "noNonNullAssertion": "error" }, "suspicious": { "noExplicitAny": "error" } } }
}
