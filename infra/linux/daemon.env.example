# systemd EnvironmentFile syntax; no shell substitutions are evaluated.
CONTROL_URL=https://CONTROL_WORKER_HOST
VM_TOKEN=REPLACE_WITH_VM_TOKEN
VM_ID=REPLACE_WITH_VM_UUID
PROVIDER_MODE=api
OPENAI_MODEL=gpt-6-astra
OPENAI_REASONING_EFFORT=low
# Optional persistent connection in either authentication mode; uses the standard service tier.
OPENAI_TRANSPORT=http
OPENAI_API_KEY=REPLACE_WITH_API_KEY
# For ChatGPT OAuth use PROVIDER_MODE=chatgpt, remove OPENAI_API_KEY,
# and set CHATGPT_TOKEN_FILE to an absolute protected OAuth token file.
# CHATGPT_TOKEN_FILE=/home/YOUR_USER/.config/autonomous-assistant/chatgpt-token.json
# Subscription sidecar; the installer adds absolute key file paths, never key contents.
CLIPROXY_URL=http://127.0.0.1:8317
# CLIPROXY_CLIENT_KEY_FILE=/home/YOUR_USER/.config/autonomous-assistant/cliproxy/client-key
# CLIPROXY_MANAGEMENT_KEY_FILE=/home/YOUR_USER/.config/autonomous-assistant/cliproxy/management-key
SCREEN_ENABLED=true
SCREEN_ICE_SERVERS=[]
DISPLAY=:99
# Installer adds absolute JOURNAL_PATH and XAUTHORITY paths.
# Optional MCP_CONFIG=/absolute/path/to/mcp.json
# Desktop MCP: open-computer-use@1.1.0 (MIT), installed by --install-deps.
# Source: https://github.com/iFurySt/open-codex-computer-use
# Optional OPEN_COMPUTER_USE_BIN=/absolute/path/to/open-computer-use
# AT_SPI_BUS_ADDRESS is discovered from xprop -root AT_SPI_BUS because Xfce's
# dbus-run-session bus differs from the systemd user bus. Override if needed:
# AT_SPI_BUS_ADDRESS=unix:path=/run/user/1000/at-spi/bus_99
# Chrome must retain --force-renderer-accessibility in start-browser.sh.
