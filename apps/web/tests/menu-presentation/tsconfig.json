{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "types": [
      "bun"
    ],
    "paths": {
      "react": [
        "../../node_modules/@types/react"
      ],
      "react/*": [
        "../../node_modules/@types/react/*"
      ],
      "react-dom/*": [
        "../../node_modules/@types/react-dom/*"
      ]
    }
  },
  "include": [
    "*.ts",
    "*.tsx"
  ]
}
